# Server Configuration
APP_ENV=dev
LOG_LEVEL=info
HTTP_ADDR=:8080
STATIC_DIR=static

# SQLite Configuration
SQLITE_DRIVER=sqlite3
SQLITE_PATH=../dev/sqlite/app.db
SQLITE_MAX_OPEN_CONNS=1
SQLITE_MAX_IDLE_CONNS=1
SQLITE_CONN_MAX_LIFETIME=0s

# MQTT Configuration (local broker; password from repo-root secrets/)
MQTT_BROKER=localhost
MQTT_PORT=1885
MQTT_CLIENT_ID=cloudpico-api
MQTT_USERNAME=api
MQTT_PASSWORD_FILE=../secrets/mqtt_api_password
MQTT_TOPIC=stations/+/telemetry
