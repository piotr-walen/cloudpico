# Mosquitto Access Control List (ACL) - Hosted Broker
# Format: topic [read|write|readwrite] <topic_pattern>
# User-based ACL rules
#
# IMPORTANT: Hosted broker only communicates with:
# - Local brokers (via bridge connections using 'bridge' user)
# - API (subscribes using 'api' user)
# Gateway devices connect to local brokers, NOT directly to hosted broker

# Bridge user: Local brokers connect via bridge and publish telemetry data
# This is the ONLY way messages from gateways reach the hosted broker
user bridge
topic write stations/+/telemetry
topic write stations/+/health

# API user: API subscribes to telemetry data from hosted broker
user api
topic read stations/+/telemetry
topic read stations/+/health
