# Server Configuration
APP_ENV=dev
LOG_LEVEL=info
HTTP_ADDR=:8080
STATIC_DIR=static

# SQLite Configuration
SQLITE_DRIVER=sqlite3
SQLITE_PATH=../dev/sqlite/app.db
SQLITE_MAX_OPEN_CONNS=1
SQLITE_MAX_IDLE_CONNS=1
SQLITE_CONN_MAX_LIFETIME=0s

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=cloudpico-server
MQTT_USERNAME=server
MQTT_PASSWORD=your-server-password-here
MQTT_TOPIC=stations/+/telemetry
